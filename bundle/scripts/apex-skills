#!/data/data/com.termux/files/usr/bin/env bash
# APEX Skill Discovery Script
# Usage: apex-skills [command] [args]

set -euo pipefail

SKILLS_DIR="$HOME/.agents/skills"
MANIFEST="$HOME/SKILLS_MANIFEST.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    echo -e "${CYAN}APEX Skill Discovery${NC}"
    echo ""
    echo "Usage: apex-skills [command]"
    echo ""
    echo "Commands:"
    echo "  list              List all active skills"
    echo "  search <query>    Search skills by name or description"
    echo "  info <skill>      Show detailed skill information"
    echo "  categories        List skill categories"
    echo "  count             Count total skills"
    echo "  recent            Show recently added skills"
    echo ""
}

list_skills() {
    echo -e "${CYAN}Active Skills (${GREEN}$(ls -1 "$SKILLS_DIR" | wc -l)${NC} total)${NC}"
    echo ""
    
    for dir in "$SKILLS_DIR"/*/; do
        if [ -f "$dir/SKILL.md" ]; then
            name=$(basename "$dir")
            desc=$(head -5 "$dir/SKILL.md" | grep "description:" | sed 's/.*description: //' | head -c 60)
            echo -e "  ${GREEN}●${NC} ${YELLOW}${name}${NC}"
            if [ -n "$desc" ]; then
                echo -e "    ${desc}..."
            fi
        fi
    done
}

search_skills() {
    local query="$1"
    echo -e "${CYAN}Searching for: ${YELLOW}${query}${NC}"
    echo ""
    
    for dir in "$SKILLS_DIR"/*/; do
        if [ -f "$dir/SKILL.md" ]; then
            name=$(basename "$dir")
            if echo "$name" | grep -qi "$query" || grep -qi "$query" "$dir/SKILL.md" 2>/dev/null; then
                echo -e "  ${GREEN}●${NC} ${YELLOW}${name}${NC}"
                head -5 "$dir/SKILL.md" | grep "description:" | sed 's/.*description: /    /'
            fi
        fi
    done
}

skill_info() {
    local skill="$1"
    local skill_dir="$SKILLS_DIR/$skill"
    
    if [ ! -d "$skill_dir" ]; then
        echo -e "${RED}Skill not found: ${skill}${NC}"
        return 1
    fi
    
    echo -e "${CYAN}Skill: ${YELLOW}${skill}${NC}"
    echo ""
    
    if [ -f "$skill_dir/SKILL.md" ]; then
        head -20 "$skill_dir/SKILL.md"
    fi
}

list_categories() {
    echo -e "${CYAN}Skill Categories${NC}"
    echo ""
    echo -e "  ${GREEN}●${NC} ${YELLOW}apex-domain${NC}        - APEX system skills (orchestrator, legal, forensic)"
    echo -e "  ${GREEN}●${NC} ${YELLOW}memory-supermemory${NC}  - Memory infrastructure"
    echo -e "  ${GREEN}●${NC} ${YELLOW}operator-efficiency${NC} - Token savings, hyper-efficiency"
    echo -e "  ${GREEN}●${NC} ${YELLOW}vercel-platform${NC}     - Vercel/Next.js skills"
    echo -e "  ${GREEN}●${NC} ${YELLOW}development${NC}        - Bootstrap, chat, release"
    echo -e "  ${GREEN}●${NC} ${YELLOW}benchmarking${NC}       - Testing and evaluation"
    echo -e "  ${GREEN}●${NC} ${YELLOW}other${NC}              - SVG animations, etc."
}

count_skills() {
    local total=$(ls -1 "$SKILLS_DIR" | wc -l)
    echo -e "${CYAN}Total Active Skills: ${GREEN}${total}${NC}"
}

recent_skills() {
    echo -e "${CYAN}Recently Added Skills${NC}"
    echo ""
    
    ls -1t "$SKILLS_DIR" | head -10 | while read -r dir; do
        if [ -f "$SKILLS_DIR/$dir/SKILL.md" ]; then
            echo -e "  ${GREEN}●${NC} ${YELLOW}${dir}${NC}"
        fi
    done
}

# Main
case "${1:-help}" in
    list)       list_skills ;;
    search)     search_skills "${2:-}" ;;
    info)       skill_info "${2:-}" ;;
    categories) list_categories ;;
    count)      count_skills ;;
    recent)     recent_skills ;;
    help|*)     usage ;;
esac
