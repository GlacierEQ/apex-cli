#!/data/data/com.termux/files/usr/bin/env bash
# Deploy APEX Omni Orchestrator — THE MASTERPIECE
set -euo pipefail

ORCH_DIR="$HOME/.apex_automation/orchestrator"
OMNI_ENGINE="$HOME/MISSIONS/AEON_777/CORE_MISSION/AEON-BRAIN-777/02_EVIDENCE_VAULT/CONSOLIDATED_ARCHIVE/APEX_SYSTEM_BLUEPRINTS/01_OMNI_ENGINE/omni_engine/Omni_Engine-main"

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║     APEX OMNI ORCHESTRATOR — THE MASTERPIECE            ║${NC}"
echo -e "${CYAN}║     205+ skills │ 6 memory layers │ 5 pillars          ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
echo ""

# Create knowledge directory
mkdir -p "$ORCH_DIR/knowledge" "$ORCH_DIR/workspace" "$ORCH_DIR/logs"

# ============================================================================
# SYMLINK ALL KNOWLEDGE SOURCES
# ============================================================================

echo -e "${YELLOW}Linking knowledge sources...${NC}"

# 1. Omni Engine (205 skills)
ln -sf "$OMNI_ENGINE/skills" "$ORCH_DIR/knowledge/omni-skills"
echo -e "  ${GREEN}✓${NC} Omni Engine: $(ls -1 "$OMNI_ENGINE/skills/" | wc -l) skills"

# 2. My Merged Skills (28)
ln -sf "$HOME/.agents/skills" "$ORCH_DIR/knowledge/my-skills"
echo -e "  ${GREEN}✓${NC} My Skills: $(ls -1 "$HOME/.agents/skills/" | wc -l) skills"

# 3. APEX_CORE Protocol
ln -sf "$HOME/.apex_vault/AGENTS/gemini/skills/APEX_CORE.md" "$ORCH_DIR/knowledge/apex-core.md"
echo -e "  ${GREEN}✓${NC} APEX_CORE: 10 foundational protocols"

# 4. Memory Rules
ln -sf "$HOME/MEMORY.md" "$ORCH_DIR/knowledge/memory-rules.md"
echo -e "  ${GREEN}✓${NC} Memory Rules: no placeholders, surgical edits"

# 5. Holographic Memory Interface
ln -sf "$HOME/MISSIONS/CONSOLIDATED/INFRASTRUCTURE/colossus-gateway/MEMORY-INTERFACE.py" "$ORCH_DIR/knowledge/memory_interface.py"
echo -e "  ${GREEN}✓${NC} Holographic Memory: 6-layer mesh"

# 6. Stealth Claw
ln -sf "$HOME/MISSIONS/CONSOLIDATED/AI_AGENTS/PRO_AGENTS/Stealth-Claw/stealth_claw/claw_core.py" "$ORCH_DIR/knowledge/stealth_claw.py"
echo -e "  ${GREEN}✓${NC} Stealth Claw: 5-pillar execution"

# 7. Colossus Gateway Tools
ln -sf "$HOME/MISSIONS/CONSOLIDATED/INFRASTRUCTURE/colossus-gateway/src/tools" "$ORCH_DIR/knowledge/colossus-tools"
echo -e "  ${GREEN}✓${NC} Colossus Gateway: 25 MCP tools"

# 8. Operator Key Vault (credentials)
ln -sf "$HOME/MISSIONS/CONSOLIDATED/INFRASTRUCTURE/APEX/key_vault/operator_key_vault.py" "$ORCH_DIR/knowledge/operator_vault.py"
echo -e "  ${GREEN}✓${NC} Operator Vault: all API keys"

# 9. MCP Connectors
ln -sf "$HOME/MISSIONS/CONSOLIDATED/INFRASTRUCTURE/APEX/APPS/apex-unified-mcp/src/connectors.ts" "$ORCH_DIR/knowledge/mcp_connectors.ts"
ln -sf "$HOME/MISSIONS/CONSOLIDATED/INFRASTRUCTURE/APEX/APPS/apex-unified-mcp/src/pillars.ts" "$ORCH_DIR/knowledge/mcp_pillars.ts"
ln -sf "$HOME/MISSIONS/CONSOLIDATED/INFRASTRUCTURE/APEX/APPS/everything-mcp-server/src" "$ORCH_DIR/knowledge/everything_mcp"
echo -e "  ${GREEN}✓${NC} MCP Connectors: 15 live, 23 tools"

# 10. Copy MCP Hub
cp "$HOME/.apex_automation/orchestrator/mcp_hub.py" "$ORCH_DIR/mcp_hub.py"
echo -e "  ${GREEN}✓${NC} MCP Hub: integrated"

# ============================================================================
# CREATE CONFIGURATION
# ============================================================================

cat > "$ORCH_DIR/config.json" << 'EOF'
{
  "name": "APEX Omni Orchestrator",
  "version": "1.0.0",
  "description": "The Masterpiece — Unified AI orchestration engine",
  "knowledge": {
    "omni_engine": "205 skills",
    "my_skills": "28 merged skills",
    "apex_core": "10 foundational protocols",
    "total": "233+ skills"
  },
  "memory": {
    "type": "holographic",
    "layers": 6,
    "cache_enabled": true,
    "zero_token_hits": true
  },
  "execution": {
    "pillars": ["legal", "forensic", "operations", "memory", "delivery"],
    "tiers": [1, 2, 3, 4],
    "stealth_mode": true
  },
  "infrastructure": {
    "ollama": "local models",
    "supabase": "database",
    "notion": "knowledge base",
    "github": "repositories"
  }
}
EOF

echo -e "  ${GREEN}✓${NC} Configuration written"

# ============================================================================
# RUN ORCHESTRATOR
# ============================================================================

echo ""
echo -e "${CYAN}Running discovery...${NC}"
cd "$ORCH_DIR"
python3 apex_omni_orchestrator.py discover

echo ""
echo -e "${CYAN}═══════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}THE MASTERPIECE IS READY${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "Usage:"
echo -e "  cd $ORCH_DIR"
echo -e "  python3 apex_omni_orchestrator.py discover"
echo -e "  python3 apex_omni_orchestrator.py search --query 'legal'"
echo -e "  python3 apex_omni_orchestrator.py execute --task 'scan placeholders' --pillar operations"
echo -e "  python3 apex_omni_orchestrator.py status"
echo ""
echo -e "Or deploy agents:"
echo -e "  apex-deploy-ultra"
echo -e "  apex-deploy-stealth-claw"
echo -e "  apex-deploy-omni"
echo -e "  apex-deploy-gemma4"
