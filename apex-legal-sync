#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# APEX Legal Ops — Integration Sync
# Connects: evidence vault, case filings, forensics, legal briefs
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

LEGAL_OPS="$HOME/MISSIONS/LEGAL_OPS"
CYBERTACK="$HOME/CYBERTACK"
CATACLYSM="$HOME/MISSIONS/THE_CATACLYSM"
CASE_FILINGS="$LEGAL_OPS/CASE_FILINGS/1FDV-23-0001009"

echo "═══════════════════════════════════════════════════════════════"
echo " APEX Legal Ops — Integration Sync"
echo "═══════════════════════════════════════════════════════════════"
echo ""

# Step 1: Sync evidence from CATACLYSM to consolidated vault
echo "📥 Step 1: Syncing evidence from CATACLYSM..."
if [ -d "$CATACLYSM/FORENSICS" ]; then
  rsync -av --update "$CATACLYSM/FORENSICS/" "$LEGAL_OPS/FORENSICS/" 2>/dev/null || true
  echo "   ✅ Forensics synced"
fi

if [ -d "$CATACLYSM/EVIDENCE" ]; then
  rsync -av --update "$CATACLYSM/EVIDENCE/" "$LEGAL_OPS/EVIDENCE_VAULT/" 2>/dev/null || true
  echo "   ✅ Evidence synced"
fi

# Step 2: Sync case structure from CATACLYSM to case filings
echo ""
echo "📥 Step 2: Syncing case structure..."
if [ -d "$CATACLYSM/CASE_STRUCTURE" ]; then
  rsync -av --update "$CATACLYSM/CASE_STRUCTURE/" "$CASE_FILINGS/" 2>/dev/null || true
  echo "   ✅ Case structure synced"
fi

# Step 3: Sync evidence from CYBERTACK to vault
echo ""
echo "📥 Step 3: Syncing CYBERTACK evidence..."
if [ -d "$CYBERTACK/CASE_1FDV-23-0001009_FINAL" ]; then
  rsync -av --update "$CYBERTACK/CASE_1FDV-23-0001009_FINAL/" "$CASE_FILINGS/" 2>/dev/null || true
  echo "   ✅ Case files synced"
fi

# Step 4: Generate unified index
echo ""
echo "📝 Step 4: Generating unified index..."
cat > "$LEGAL_OPS/INDEX.md" << 'EOF'
# APEX Legal Ops — Unified Index
_Case 1FDV-23-0001009 | Generated by apex-legal-sync_

## Directory Structure

```
LEGAL_OPS/
├── CASE_FILINGS/1FDV-23-0001009/     # All case documents
│   ├── 00_CASE_FILING/               # Federal complaint
│   ├── 01_EXHIBITS/                  # 40 exhibits
│   ├── 02_EVIDENCE/                  # Evidence items
│   ├── 03_FORENSIC/                  # Forensic reports
│   ├── 04_LEGAL/                     # Legal analysis
│   ├── 05_TIMELINE/                  # Case timeline
│   ├── 06_DAMAGES/                   # Damages calculation
│   ├── 07_DEFENDANTS/                # Defendant info
│   ├── ACTORS/                       # Actor profiles (Brower, etc.)
│   ├── EVIDENCE/                     # Evidence inventory
│   ├── FORENSICS/                    # Forensic analysis
│   └── PLEADINGS/                    # Court pleadings
│
├── EVIDENCE_VAULT/                   # Consolidated evidence
├── LEGAL_BRIEFS/                     # Brief templates
├── FORENSICS/                        # Forensic reports
├── LEGAL_RESEARCH/                   # Legal research
└── INTEGRATIONS/                     # Integration scripts
```

## Key Files

- **Federal Complaint**: CASE_FILINGS/1FDV-23-0001009/00_CASE_FILING/
- **Exhibits**: CASE_FILINGS/1FDV-23-0001009/01_EXHIBITS/EXHIBIT_INDEX.md
- **Damages**: CASE_FILINGS/1FDV-23-0001009/06_DAMAGES/DAMAGES_CALCULATION.md
- **Brower Dossier**: CASE_FILINGS/1FDV-23-0001009/FORENSICS/ACTOR_SUMMARY_Brower.md
- **Timeline**: CASE_FILINGS/1FDV-23-0001009/MASTER_CASE_TIMELINE.md

## GitHub Repos (Legal)

- `case-1FDV-23-0001009-legal-documents` — Core legal document vault
- `1FDV-23-0001009-FEDERAL-WARFARE` — Federal litigation command center
- `CYBERTACK-1FDV-23-0001009` — Cyberattack evidence
- `THE_CATACLYSM` — Forensic email archive
- `legal-brief-pipeline` — Brief compilation pipeline
- `aspen-grove-legal` — Legal knowledge base
- `aspen-grove-evidence` — Evidence vault
- `Pro-Legal-Warfare` — Legal warfare engine
- `Pro-Evidence` — Forensic evidence vault
- `Pro-Forensics` — Forensic MCP server
EOF

echo "   ✅ Index generated"

# Step 5: Verify integrity
echo ""
echo "🔐 Step 5: Verifying evidence integrity..."
EVIDENCE_COUNT=$(find "$LEGAL_OPS/EVIDENCE_VAULT" -type f 2>/dev/null | wc -l)
FORENSICS_COUNT=$(find "$LEGAL_OPS/FORENSICS" -type f 2>/dev/null | wc -l)
CASE_COUNT=$(find "$CASE_FILINGS" -type f 2>/dev/null | wc -l)

echo "   📊 Evidence items: $EVIDENCE_COUNT"
echo "   📊 Forensics reports: $FORENSICS_COUNT"
echo "   📊 Case documents: $CASE_COUNT"

echo ""
echo "═══════════════════════════════════════════════════════════════"
echo " ✅ Integration sync complete"
echo "═══════════════════════════════════════════════════════════════"
