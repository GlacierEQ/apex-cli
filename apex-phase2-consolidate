EOF

echo "   ✅ Index updated"

# Step 7: Final size report
echo ""
echo "📊 Step 7: Final consolidation report..."
echo "   📊 CONSOLIDATED total: $(du -sh "$CONSOLIDATED" 2>/dev/null | awk '{print $1}')"
echo "   📊 MISSIONS remaining: $(du -sh "$HOME/MISSIONS" --exclude="$HOME/MISSIONS/CONSOLIDATED" 2>/dev/null | awk '{print $1}')"
echo "   📊 Symlinks: $(find "$HOME/MISSIONS" -maxdepth 3 -type l 2>/dev/null | wc -l)"

echo ""
echo "═══════════════════════════════════════════════════════════════"
echo " ✅ Phase 2 consolidation complete"
echo "═══════════════════════════════════════════════════════════════"
