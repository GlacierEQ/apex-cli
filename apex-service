#!/usr/bin/env bash
# APEX Service Manager — Start/Stop/Status all services
set -euo pipefail

APEX_DIR="$HOME/.apex_automation"
PID_DIR="$APEX_DIR/pids"
LOG_DIR="$APEX_DIR/logs"
mkdir -p "$PID_DIR" "$LOG_DIR"

CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

show_status() {
    echo -e "${CYAN}╔══════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║          APEX SERVICE STATUS                    ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════╝${NC}"
    echo ""
    
    for service in gdrive_watcher gdrive_intel fileboss pipelines; do
        pid_file="$PID_DIR/${service}.pid"
        if [ -f "$pid_file" ]; then
            pid=$(cat "$pid_file")
            if kill -0 "$pid" 2>/dev/null; then
                echo -e "  ${GREEN}●${NC} ${service}: running (PID: ${pid})"
            else
                echo -e "  ${RED}●${NC} ${service}: stopped"
            fi
        else
            echo -e "  ${RED}●${NC} ${service}: not started"
        fi
    done
    
    echo ""
    echo -e "${CYAN}Cron jobs:${NC}"
    crontab -l 2>/dev/null | grep -v "^#" | wc -l | xargs -I {} echo "  {} active jobs"
}

start_services() {
    echo -e "${CYAN}Starting APEX services...${NC}"
    
    # Start GDrive Watcher
    nohup python3 "$APEX_DIR/gdrive_final/gdrive_watcher.py" watch >> "$LOG_DIR/gdrive_watcher.log" 2>&1 &
    echo $! > "$PID_DIR/gdrive_watcher.pid"
    echo -e "${GREEN}✅ GDrive Watcher started${NC}"
    
    echo -e "${GREEN}All services started${NC}"
}

stop_services() {
    echo -e "${CYAN}Stopping APEX services...${NC}"
    
    for service in gdrive_watcher; do
        pid_file="$PID_DIR/${service}.pid"
        if [ -f "$pid_file" ]; then
            pid=$(cat "$pid_file")
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid"
                rm -f "$pid_file"
                echo -e "${GREEN}✅ ${service} stopped${NC}"
            fi
        fi
    done
    
    echo -e "${GREEN}All services stopped${NC}"
}

case "${1:-status}" in
    start)   start_services ;;
    stop)    stop_services ;;
    status)  show_status ;;
    restart) stop_services; start_services ;;
    *)       echo "Usage: apex-service {start|stop|status|restart}" ;;
esac
