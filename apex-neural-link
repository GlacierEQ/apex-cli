#!/usr/bin/env bash
# apex-neural-link — Janus V2 Microwave ↔ Synthesizer steward channel
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
export CASE_ID="${CASE_ID:-1FDV-23-0001009}"
export APEX_PROFILE="${APEX_PROFILE:-coremaximized}"

SCRIPT="$ROOT/scripts/establish_neural_link.py"
if [[ ! -f "$SCRIPT" ]]; then
  SCRIPT="$ROOT/bundle/scripts/establish_neural_link.py"
fi

# Prefer Aspen/operator venv (fastapi/uvicorn), else python3
if [[ -x "$HOME/GlacierEQ/aspen-grove-operator-v7/.venv/bin/python" ]]; then
  PY="$HOME/GlacierEQ/aspen-grove-operator-v7/.venv/bin/python"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="${PYTHON:-python3}"
fi

exec "$PY" "$SCRIPT" "$@"
