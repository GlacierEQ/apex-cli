#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# APEX Pro-* → Aspen Grove Consolidation
# Archives overlapping Pro-* repos, keeps unique ones
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

echo "═══════════════════════════════════════════════════════════════"
echo " APEX Pro-* → Aspen Grove Consolidation"
echo "═══════════════════════════════════════════════════════════════"
echo ""

# Step 1: Identify overlapping Pro-* repos
echo "📦 Step 1: Identifying overlapping Pro-* repos..."
unset GITHUB_TOKEN 2>/dev/null

# These Pro-* repos duplicate aspen-grove-* functionality
OVERLAPPING=(
  "Pro-Evidence"           # duplicates aspen-grove-evidence
  "Pro-Forensics"          # duplicates aspen-grove-evidence (forensics)
  "Pro-Legal-Docs"         # duplicates aspen-grove-legal
  "Pro-Legal-Warfare"      # duplicates aspen-grove-legal (warfare)
  "Pro-Memory"             # duplicates aspen-grove-memory
  "Pro-Connectors"         # duplicates aspen-grove-connectors
  "Pro-Swarm"              # duplicates aspen-grove-swarm
  "Pro-Juggernaut"         # duplicates aspen-grove-evidence (ingestion)
)

# These Pro-* repos have UNIQUE functionality — keep them
UNIQUE=(
  "Pro-AEON-777"           # unique: AEON foundation architecture
  "Pro-AEON-BRAIN"         # unique: AEON brain intelligence
  "Pro-DOCTOR-STRANGE"     # unique: universal orchestration
  "Pro-Mastermind"         # unique: AI orchestration engine
  "Pro-God-Mind"           # unique: operator consciousness
  "Pro-xAI"                # unique: xAI flagship
  "Pro-apex-fs-commander"  # unique: file system commander
  "Pro-comet-agent"        # unique: comet agent
  "Pro-Gemma"              # unique: Gemma dispatch
  "Pro-Kai"                # unique: Linux OS layer
  "Pro-Security"           # unique: security architecture
  "Pro-CI"                 # unique: CI/CD guardian
)

echo "   Overlapping (to archive): ${#OVERLAPPING[@]} repos"
echo "   Unique (to keep): ${#UNIQUE[@]} repos"

# Step 2: Archive overlapping Pro-* repos
echo ""
echo "📦 Step 2: Archiving overlapping Pro-* repos..."
for repo in "${OVERLAPPING[@]}"; do
  echo "   📋 Archiving: $repo"
  
  # Create archive branch
  MAIN_SHA=$(gh api "repos/GlacierEQ/$repo/branches/main" --jq '.commit.sha' 2>/dev/null || \
             gh api "repos/GlacierEQ/$repo/branches/master" --jq '.commit.sha' 2>/dev/null || echo "")
  
  if [ -n "$MAIN_SHA" ]; then
    gh api "repos/GlacierEQ/$repo/git/refs" -X POST \
      -f ref="refs/heads/archive-pre-consolidation" \
      -f sha="$MAIN_SHA" 2>/dev/null && echo "      ✅ Archive branch created" || echo "      (branch exists)"
  fi
  
  # Mark as archived
  gh api "repos/GlacierEQ/$repo" -X PATCH -f archived=true 2>/dev/null && echo "      ✅ Archived" || echo "      (already archived)"
done

# Step 3: Verify
echo ""
echo "📊 Step 3: Verification..."
echo "   📋 Archived Pro-* repos: ${#OVERLAPPING[@]}"
echo "   📋 Kept Pro-* repos: ${#UNIQUE[@]}"
echo "   📋 aspen-grove-* repos: 7 (canonical)"
echo "   📋 Cross-reference: Each archived Pro-* has a canonical aspen-grove-* counterpart"

echo ""
echo "═══════════════════════════════════════════════════════════════"
echo " ✅ Pro-* consolidation complete"
echo "    Overlapping repos archived. Unique repos preserved."
echo "═══════════════════════════════════════════════════════════════"
